# App
APP_NAME=edu-rag
APP_VERSION=0.1.0
DEBUG=false
DEFAULT_TENANT_ID=default
IMPORT_SERVICE_PORT=8000
QUERY_SERVICE_PORT=8001

# LLM
OPENAI_API_KEY=
OPENAI_API_BASE=
LLM_DEFAULT_MODEL=qwen-flash
LLM_DEFAULT_TEMPERATURE=0.1
VL_MODEL=qwen3-vl-flash

# Embedding
BGE_M3_PATH=
BGE_DEVICE=cuda:0
BGE_FP16=true
BGE_RERANKER_LARGE=
BGE_RERANKER_DEVICE=cuda:0
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1536

# Milvus
MILVUS_URL=http://localhost:19530
MILVUS_CHUNKS_COLLECTION=edu_kb_chunks
MILVUS_QUESTIONS_COLLECTION=edu_questions
MILVUS_COURSE_NAMES_COLLECTION=edu_course_names
MILVUS_VIDEO_SEGMENTS_COLLECTION=edu_video_segments
MILVUS_MULTIMODAL_COLLECTION=edu_multimodal_assets
MILVUS_METRIC_TYPE=COSINE
MILVUS_MIN_COSINE_SCORE=0.75

# MongoDB
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=edu_rag

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=edu-knowledge-base
MINIO_SECURE=false

# Parser
DOCX_PARSE_MODE=python-docx
DOCX_ENABLE_TABLE_PARSE=true
DOCX_ENABLE_IMAGE_PLACEHOLDER=true

